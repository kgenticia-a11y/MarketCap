# Base URL of the FastAPI backend.
# Local dev: http://localhost:8000
# Production: https://api.your-domain.com
VITE_API_URL=http://localhost:8000

# Paper trading UI (parked feature). Defaults: on in dev, off in production
# builds. Set explicitly to "true"/"false" to override.
VITE_ENABLE_PAPER_TRADING=
