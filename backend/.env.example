DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256
WEB_CONCURRENCY=2
JWT_EXPIRE_MINUTES=60
# Market data (yfinance / Yahoo Finance) needs NO API key.
# GROQ_API_KEY powers the AI co-pilot features (via the Groq free tier).
# Get a free key at https://console.groq.com
GROQ_API_KEY=
# Optional: preferred Groq model ID (e.g. openai/gpt-oss-120b). Leave empty
# to use the built-in fallback chain. If Groq retires the configured model,
# the backend automatically falls back to the next supported model.
GROQ_MODEL=
# Optional: preferred Groq model ID for deep analysis work (standard and
# deep-dive analyst reports). Leave empty to use the built-in deep-tier
# chain, which prefers the largest reasoning-capable model at high
# reasoning effort. Same automatic fallback semantics as GROQ_MODEL.
GROQ_DEEP_MODEL=

# Shared secret for the internal /internal/auto-checkpoint endpoint that
# Supabase's pg_cron calls once a week to snapshot every published memo.
# Must match the marketcap_checkpoint_key vault secret in Supabase. Empty
# disables the endpoint (503).
CHECKPOINT_CRON_SECRET=

# Shared secret for the internal /internal/earnings-batch endpoint that the
# earnings-recap-trigger edge function calls daily to generate AI earnings
# recaps. Must match the INTERNAL_API_KEY secret set on the edge function.
# Empty rejects every batch call (401), disabling the daily recap automation.
INTERNAL_API_KEY=
